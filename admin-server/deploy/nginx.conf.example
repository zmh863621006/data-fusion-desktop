# Place limit_req_zone in the nginx http {} block.
limit_req_zone $binary_remote_addr zone=df_login:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=df_api:10m rate=30r/s;

server {
    listen 80;
    server_name admin.example.com;
    return 301 https://admin.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 15s;
    limit_req_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    location = /api/admin/login {
        # Add your fixed office/VPN address in ALL management locations, including uploads.
        allow 127.0.0.1;
        # allow 203.0.113.10;
        deny all;
        limit_req zone=df_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }
    location /api/admin/ {
        allow 127.0.0.1;
        # allow 203.0.113.10;
        deny all;
        limit_req zone=df_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }
    location = /api/admin/updates/upload {
        allow 127.0.0.1;
        # allow 203.0.113.10;
        deny all;
        limit_req zone=df_api burst=5 nodelay;
        client_max_body_size 500m;
        client_body_timeout 60s;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass http://127.0.0.1:8787;
    }
    location /api/releases/ {
        limit_req zone=df_api burst=60 nodelay;
        proxy_buffering off;
        proxy_read_timeout 600s;
        send_timeout 600s;
        proxy_pass http://127.0.0.1:8787;
    }
    # Desktop activation, license checks and enterprise cache resolution.
    location /api/ {
        limit_req zone=df_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }
    location / {
        allow 127.0.0.1;
        # allow 203.0.113.10;
        deny all;
        proxy_pass http://127.0.0.1:8787;
    }
}
