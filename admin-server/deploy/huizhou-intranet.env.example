# Copy outside the source tree and fill the actual intranet domain and private secret paths.
NODE_ENV=production
ADMIN_DEPLOYMENT=huizhou-intranet
ADMIN_PUBLIC_ORIGIN=https://fusion.example.invalid
ADMIN_UPDATE_PUBLIC_ORIGIN=https://fusion.example.invalid
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_COOKIE_SECURE=true
ADMIN_DB_PATH=/srv/data/huizhou-fusion-assistant/database/admin.sqlite
ADMIN_LICENSE_PRIVATE_KEY=/etc/huizhou-fusion-assistant/license-private.pem
ADMIN_MANAGEMENT_PUBLIC=false
ADMIN_MANAGEMENT_ALLOWED_IPS=127.0.0.1
ADMIN_UPDATE_STORAGE_MODE=local
ADMIN_BUSINESS_STORAGE_MODE=local
ADMIN_BUSINESS_LOCAL_FEED_BASE=https://fusion.example.invalid/business-updates/
ADMIN_RETURN_UPLOADS_ENABLED=true
ADMIN_UPDATE_DIRECTORY=/srv/data/huizhou-fusion-assistant/updates/installers
ADMIN_BUSINESS_UPDATE_DIRECTORY=/srv/data/huizhou-fusion-assistant/updates/business
ESTABLISHMENT_OSS_ENABLED=false
# Reuse the existing enterprise APPCODE in this private server environment only.
# This is NOT an OSS AccessKey. Never put its real value in this example or a desktop package.
ALIYUN_ENTERPRISE_APPCODE=
