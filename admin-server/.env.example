# Copy to admin-server/.env for local use; npm run admin:start reads it.
# Production: use a protected systemd EnvironmentFile instead.
NODE_ENV=production
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_COOKIE_SECURE=true
ADMIN_PUBLIC_ORIGIN=https://admin.example.com
# Optional dedicated HTTPS installer origin; defaults to ADMIN_PUBLIC_ORIGIN.
# It is fixed server configuration, never inferred from the request Host header.
# ADMIN_UPDATE_PUBLIC_ORIGIN=https://updates.example.com
# Default: releases/ beside ADMIN_DB_PATH. Keep outside readonly code/public roots.
# ADMIN_UPDATE_DIRECTORY=/var/lib/data-fusion/releases
# Only for an explicitly chosen HTTP deployment; credentials are unencrypted.
# ADMIN_ALLOW_INSECURE_HTTP=true
# ADMIN_COOKIE_SECURE=false
# ADMIN_PUBLIC_ORIGIN=http://your-ip:9087
# ADMIN_MANAGEMENT_ALLOWED_IPS=your-fixed-office-ip
# Alternatively, explicitly allow every source to reach the login page:
# ADMIN_MANAGEMENT_PUBLIC=true
# Trust only the actual reverse-proxy peer. It must overwrite X-Real-IP.
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_DB_PATH=/var/lib/data-fusion/admin.sqlite
ADMIN_LICENSE_PRIVATE_KEY=/etc/data-fusion/license-private.pem
# Required ONLY when creating the first database. Set a unique strong password.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Optional paid enterprise lookup. Super-admin must enable it in the UI.
ALIYUN_ENTERPRISE_APPCODE=

# Optional Shenzhen establishment Excel ingestion from a private OSS prefix.
# Use a separate RAM identity with ListObjects/GetObject only. No public bucket required.
ESTABLISHMENT_OSS_ENABLED=false
ESTABLISHMENT_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ESTABLISHMENT_OSS_BUCKET=
ESTABLISHMENT_OSS_PREFIX=szjx/establishments/
ESTABLISHMENT_OSS_ACCESS_KEY_ID=
ESTABLISHMENT_OSS_ACCESS_KEY_SECRET=
ESTABLISHMENT_OSS_SECURITY_TOKEN=
